# ==============================================================================
# Secure Client-Server Communication Environment Configuration
# ==============================================================================

# Network Configuration
HOST=127.0.0.1
PORT=8443

# TLS Certificate, Private Key, and PKI Paths
CA_FILE=server/certs/ca.crt
CERT_FILE=server/certs/server.crt
KEY_FILE=server/certs/server.key
CLIENT_CERT_FILE=server/certs/client.crt
CLIENT_KEY_FILE=server/certs/client.key

# Mutual TLS (mTLS) Security Enforcement
REQUIRE_CLIENT_CERT=true

# Storage Settings
RECEIVED_FILES_DIR=received_files
CHUNK_SIZE=65536

# Socket and Concurrency Settings
BUFFER_SIZE=4096
MAX_CLIENTS=5

# Security and Handshake Settings
AUTH_TIMEOUT=120.0
